# Configuração Gmail
# Para usar com Gmail, você precisa gerar uma "Senha de App":
# 1. Acesse https://myaccount.google.com/security
# 2. Ative a verificação em 2 etapas (se ainda não ativou)
# 3. Vá em "Senhas de app" e gere uma nova senha
# 4. Copie a senha gerada e cole abaixo

EMAIL_ADDRESS=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-de-app-aqui

# Configuração SMTP (padrão Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Rate limiting
EMAILS_PER_MINUTE=20
DELAY_BETWEEN_EMAILS=3

# Monitor Gmail + WhatsApp Alert
WATCH_SENDER=solenidadecarteira@oabmg.org.br
WHATSAPP_PHONE=+5531996312222
CALLMEBOT_APIKEY=sua-api-key-aqui
CHECK_INTERVAL=60
